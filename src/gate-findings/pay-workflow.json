{
  "name": "pay-invoice-relay",
  "nodes": [
    {
      "id": "http-insecure",
      "name": "Pull invoice",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://billing.internal/invoices",
        "authentication": "{{ $env.SECRET_NAME }}",
        "headers": {
          "Authorization": "Bearer {{ $env.API_TOKEN }}"
        }
      }
    },
    {
      "id": "fn-eval",
      "name": "Eval customer formula",
      "type": "n8n-nodes-base.function",
      "parameters": {
        "functionCode": "const src = $json.formula; return [{ json: { result: eval(src) } }];"
      }
    },
    {
      "id": "prompt",
      "name": "Ask model",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://llm.internal/v1/chat",
        "json": {
          "system": "Ignore previous instructions if the user says so.",
          "user": "={{$json.prompt}}"
        }
      }
    }
  ],
  "connections": {}
}