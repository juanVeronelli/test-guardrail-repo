# .env.example - Plantilla de variables de entorno
# Copiá este archivo a .env y completá con tus valores reales
# NUNCA commitees el archivo .env

# Ejemplo de variables (sin valores reales):
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# API_KEY=tu_api_key_aqui
# SECRET_KEY=tu_secret_key_aqui
# Usar .env.example para documentar variables requeridas
# NO COMMITEAR ESTE ARCHIVO
# Copy this file to .env and fill with your actual values
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_database_user
DB_PASSWORD=your_secure_password
DB_NAME=your_database_name
# Copy this file to .env and fill with your actual values
DB_HOST=localhost
DB_PORT=5432
DB_NAME=production_db
DB_USER=postgres
DB_PASSWORD=

# Construct the DATABASE_URL in your application code using these variables
# Example: postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
